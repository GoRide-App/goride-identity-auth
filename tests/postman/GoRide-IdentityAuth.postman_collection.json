            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Does not return 500', function () {",
                  "    pm.expect(pm.response.code, 'a corrupt cookie must not produce an unhandled exception').to.not.eql(500);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Logout clears the session",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "app_session={{sessionCookie}}",
                "description": "Session cookie copied from the browser after a real OIDC login."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ]
            },
            "description": "RUN THIS LAST - it invalidates {{sessionCookie}} for every other request in the collection."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Redirects on sign-out', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([301, 302, 303]);",
                  "});",
                  "const setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "pm.test('Session cookie is cleared', function () {",
                  "    pm.expect(setCookie).to.include('app_session');",
                  "});"
                ]
              }
            }
          ],
          "response": [],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Session is dead after logout",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "app_session={{sessionCookie}}",
                "description": "Session cookie copied from the browser after a real OIDC login."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me",
