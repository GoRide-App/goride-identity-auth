    {
      "name": "SCRUM-38 - Silent session refresh via refresh token rotation",
      "description": "Before running: in the Asgardeo console set the application's access token lifetime to 120 seconds so expiry is reachable in a test window. Run 'Baseline', wait out the lifetime, then run the rest in order.",
      "item": [
        {
          "name": "Baseline - session works and is not renewed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "app_session={{sessionCookie}}",
                "description": "Session cookie copied from the browser after a real OIDC login."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const setCookie = pm.response.headers.get('Set-Cookie');",
                  "pm.test('No cookie re-issued while the token is still fresh', function () {",
                  "    const renewed = setCookie != null && setCookie.indexOf('app_session') !== -1;",
                  "    pm.expect(renewed, 'a renewal this early means the expiry window check is wrong').to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "After expiry - session refreshes silently",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "app_session={{sessionCookie}}",
                "description": "Session cookie copied from the browser after a real OIDC login."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            },
            "description": "Wait until the access token lifetime has elapsed before sending this. The rotated cookie is captured into {{sessionCookie}} automatically so later requests keep working."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Still authenticated - no re-login required', function () {",
                  "    pm.expect(pm.response.code, 'a 401 means the refresh_token grant failed').to.eql(200);",
                  "});",
                  "const setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "pm.test('A new app_session cookie was issued (rotation happened)', function () {",
                  "    pm.expect(setCookie, 'ShouldRenew should re-issue the cookie carrying the rotated refresh token').to.include('app_session');",
                  "});",
                  "pm.test('Refreshed identity is still correct', function () {",
                  "    pm.expect(pm.response.json().email).to.be.a('string').and.include('@');",
                  "});",
                  "const m = setCookie.match(/app_session=([^;]+)/);",
                  "if (m) { pm.collectionVariables.set('sessionCookie', m[1]); console.log('Rotated cookie captured automatically.'); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "A tampered cookie is rejected",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "app_session={{sessionCookie}}TAMPERED"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            }
