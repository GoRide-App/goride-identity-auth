              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const p = pm.response.json();",
                  "pm.test('Is a SCIM2 user resource', function () {",
                  "    pm.expect(p.schemas).to.include('urn:ietf:params:scim:schemas:core:2.0:User');",
                  "});",
                  "pm.test('Has an id and a userName', function () {",
                  "    pm.expect(p.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(p.userName).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('originalGivenName', (p.name && p.name.givenName) || '');",
                  "pm.collectionVariables.set('originalFamilyName', (p.name && p.name.familyName) || '');",
                  "console.log('Saved original name:', JSON.stringify(p.name));"
                ]
              }
            }
          ],
          "response": []
        },
