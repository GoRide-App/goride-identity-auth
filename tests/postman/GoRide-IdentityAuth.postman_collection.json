{
  "info": {
    "name": "GoRide Identity & Auth - QA",
    "_postman_id": "9c1f5b62-3a44-4c7e-9c11-6b0d2f8a4e10",
    "description": "QA test suite for the GoRide identity/auth service, organised one folder per SCRUM ticket.\n\n## Before you start\n\n1. Turn OFF SSL certificate verification: Settings > General > 'SSL certificate verification'. The API runs on the .NET dev certificate.\n2. Start the API with `dotnet run` from `src/` on the branch under test.\n3. Select the 'GoRide - Local' environment.\n\n## Getting the sessionCookie value\n\nThis API uses an HttpOnly session cookie, not a bearer token, so the login has to happen in a real browser first:\n\n1. Open `https://localhost:7136/login` in Chrome and sign in.\n2. Press F12 > Application > Cookies > `https://localhost:7136`.\n3. Copy the **value** of the `app_session` cookie.\n4. Paste it into the `sessionCookie` environment variable.\n\nThe cookie lasts 8 hours. If requests start returning 401, repeat these steps.\n\n## Branch coverage\n\nSCRUM-33 is a superset of SCRUM-30 and SCRUM-38, so running this whole collection against the SCRUM-33 branch exercises all three at once. SCRUM-31 is not implemented and its folder is expected to fail.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Preflight",
      "description": "Run this first. If these fail, nothing else will pass and the problem is configuration, not the feature under test.",
      "item": [
        {
          "name": "API is up and configuration is bound",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/openapi/v1.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "openapi",
                "v1.json"
              ]
            },
            "description": "Requires ASPNETCORE_ENVIRONMENT=Development. A 500 means the Asgardeo client id/secret are not set."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Not a 500 - configuration is bound', function () {",
                  "    pm.expect(pm.response.code, 'A 500 here almost always means Asgardeo:ClientId is missing from user-secrets').to.not.eql(500);",
                  "});",
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Is an OpenAPI document', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('openapi');",
                  "});",
                  "pm.test('Responds under 5s', function () { pm.expect(pm.response.responseTime).to.be.below(5000); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "SCRUM-28 - Identity Server provisioned and app registered",
      "description": "Verifies the Asgardeo (WSO2) tenant exists, is configured for the authorization-code + refresh-token flow, and that the backend actually enforces authentication.",
      "item": [
        {
          "name": "Asgardeo discovery document is published",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{asgardeoBase}}/oauth2/token/.well-known/openid-configuration",
              "host": [
                "{{asgardeoBase}}"
              ],
              "path": [
                "oauth2",
                "token",
                ".well-known",
                "openid-configuration"
              ]
            },
            "description": "The '/oauth2/token/.well-known/...' path looks wrong but is correct for Asgardeo. Do not 'fix' it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const d = pm.response.json();",
                  "pm.test('Issuer belongs to the goride tenant', function () {",
                  "    pm.expect(d.issuer).to.include('goride');",
                  "});",
                  "pm.test('Authorization code flow is supported', function () {",
                  "    pm.expect(d.grant_types_supported).to.include('authorization_code');",
                  "});",
                  "pm.test('Refresh token grant is supported (needed by SCRUM-38)', function () {",
                  "    pm.expect(d.grant_types_supported).to.include('refresh_token');",
                  "});",
                  "pm.test('PKCE S256 is supported', function () {",
                  "    pm.expect(d.code_challenge_methods_supported).to.include('S256');",
                  "});",
                  "pm.test('openid scope is offered', function () {",
                  "    pm.expect(d.scopes_supported).to.include('openid');",
                  "});",
                  "pm.collectionVariables.set('authorizationEndpoint', d.authorization_endpoint);",
                  "pm.collectionVariables.set('tokenEndpoint', d.token_endpoint);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "SCIM2 API is enabled and protected",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{asgardeoBase}}/scim2/Me",
              "host": [
                "{{asgardeoBase}}"
              ],
              "path": [
                "scim2",
                "Me"
              ]
            },
            "description": "Confirms the SCIM2 endpoint SCRUM-33 depends on exists and is not public."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unauthenticated SCIM2 call is rejected', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Backend rejects anonymous callers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            },
            "description": "The fallback authorization policy must make every endpoint authenticated by default."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401, not 500', function () { pm.response.to.have.status(401); });",
                  "pm.test('No identity leaked in the body', function () {",
                  "    pm.expect(pm.response.text()).to.not.include('@');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
