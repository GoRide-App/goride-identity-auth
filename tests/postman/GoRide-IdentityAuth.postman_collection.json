    {
      "name": "SCRUM-30 - Rider login via OIDC authorization code flow",
      "description": "Everything except the first request needs {{sessionCookie}} to be set. See the collection description for how to get it.",
      "item": [
        {
          "name": "GET /login challenges Asgardeo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Redirect following is OFF for this request so the 302 can be asserted. .NET 10 uses Pushed Authorization Requests when the tenant advertises them, which hides the PKCE parameters behind a request_uri - both forms are accepted here."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Redirects (302)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([301, 302, 303]);",
                  "});",
                  "const loc = pm.response.headers.get('Location') || '';",
                  "pm.test('Redirects to the Asgardeo tenant', function () {",
                  "    pm.expect(loc).to.include('api.asgardeo.io');",
                  "});",
                  "pm.test('Uses the authorization code flow', function () {",
                  "    pm.expect(loc).to.include('response_type=code');",
                  "});",
                  "pm.test('Sends a client_id', function () {",
                  "    pm.expect(loc).to.include('client_id=');",
                  "});",
                  "pm.test('Uses PKCE or Pushed Authorization Requests', function () {",
                  "    const pkce = loc.includes('code_challenge_method=S256');",
                  "    const par = loc.includes('request_uri=');",
                  "    pm.expect(pkce || par, 'expected code_challenge_method=S256 or a PAR request_uri').to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "response": [],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "GET /api/me returns the signed-in identity",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "app_session={{sessionCookie}}",
                "description": "Session cookie copied from the browser after a real OIDC login."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "pm.test('Returns a name', function () { pm.expect(b.name).to.be.a('string').and.not.empty; });",
                  "pm.test('Returns an email', function () { pm.expect(b.email).to.be.a('string').and.include('@'); });",
                  "pm.test('Returns a roles array', function () { pm.expect(b.roles).to.be.an('array'); });",
                  "pm.collectionVariables.set('currentRoles', JSON.stringify(b.roles || []));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Claims include the roles claim",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "app_session={{sessionCookie}}",
                "description": "Session cookie copied from the browser after a real OIDC login."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/debug-claims",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "onboarding",
                "debug-claims"
              ]
            },
            "description": "Highest-value diagnostic in the collection. If the roles claim is absent, role checks fail for the wrong reason."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const claims = pm.response.json();",
                  "pm.test('Response is a claim list', function () { pm.expect(claims).to.be.an('array'); });",
                  "pm.test('A claim of type roles is present', function () {",
                  "    const found = claims.some(function (c) { return (c.type || c.Type) === 'roles'; });",
                  "    pm.expect(found, 'Without a roles claim, [Authorize(Roles=...)] silently never matches and every role-based test below is meaningless').to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
