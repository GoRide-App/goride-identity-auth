    {
      "name": "SCRUM-31 - Forgotten password via email OTP (NOT IMPLEMENTED)",
      "description": "The SCRUM-31 branch is byte-identical to SCRUM-30 - no recovery code has been written. These requests document the expected contract and will return 404 today. That failure IS the test result: report it as 'feature not delivered', not as a broken test. Confirm the final route names with the developer before sign-off.",
      "item": [
        {
          "name": "Request a password reset OTP",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/account/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "account",
                "forgot-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Endpoint exists', function () {",
                  "    pm.expect(pm.response.code, 'SCRUM-31 is not implemented on this branch').to.not.eql(404);",
                  "});",
                  "pm.test('Accepts the request', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 202, 204]);",
                  "});",
                  "pm.collectionVariables.set('forgotPasswordStatus', pm.response.code);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Unknown email must not reveal whether an account exists",
