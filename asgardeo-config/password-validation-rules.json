[
    {
        "field": "password",
        "rules": [
            {
                "validator": "NumeralValidator",
                "properties": [
                    {
                        "key": "min.length",
                        "value": "1"
                    }
                ]
            },
            {
                "validator": "LengthValidator",
                "properties": [
                    {
                        "key": "min.length",
                        "value": "8"
                    },
                    {
                        "key": "max.length",
                        "value": "64"
                    }
                ]
            },
            {
                "validator": "UpperCaseValidator",
                "properties": [
                    {
                        "key": "min.length",
                        "value": "1"
                    }
                ]
            },
            {
                "validator": "LowerCaseValidator",
                "properties": [
                    {
                        "key": "min.length",
                        "value": "1"
                    }
                ]
            },
            {
                "validator": "SpecialCharacterValidator",
                "properties": [
                    {
                        "key": "min.length",
                        "value": "0"
                    }
                ]
            }
        ]
    },
    {
        "field": "username",
        "rules": [
            {
                "validator": "LengthValidator",
                "properties": [
                    {
                        "key": "min.length",
                        "value": "3"
                    },
                    {
                        "key": "max.length",
                        "value": "50"
                    }
                ]
            },
            {
                "validator": "AlphanumericValidator",
                "properties": [
                    {
                        "key": "enable.special.characters",
                        "value": "false"
                    },
                    {
                        "key": "enable.validator",
                        "value": "true"
                    }
                ]
            }
        ]
    }
