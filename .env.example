# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Local database (your own container, not the Azure one)
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme

# Asgardeo organisation base URL (no trailing slash) and the GoRide app credentials
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/goride
ASGARDEO_CLIENT_ID=changeme
ASGARDEO_CLIENT_SECRET=changeme

# Machine-to-machine app used for SCIM2 management calls (role assignment, account disable)
ASGARDEO_MGMT_CLIENT_ID=changeme
ASGARDEO_MGMT_CLIENT_SECRET=changeme
